# Root .gitignore for ProofChain Enterprise Repository

# Dependencies & Package Managers
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundler Bundles
dist/
dist-ssr/
build/
.next/
out/
frontend/dist/
frontend/build/

# Environment Configurations & Secrets (STRICT - NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
*.env.*
secret.json
secrets.json
auth.json
firebase*.json
service-account*.json
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# Solana Blockchain & Anchor Artifacts
blockchain/target/
**/target/
blockchain/.anchor/
.anchor/
test-ledger/
**/test-ledger/
*.keypair.json
**/*-keypair.json
**/*-upgrade-buffer.json
*local-wallet.json
id.json

# Local Databases & Prisma Caches
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/prisma/migrations/dev/

# Application & Process Logs
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Tooling & Compiler Caches
.eslintcache
.cache/
.parcel-cache/
.vite/
.rolldown/
.rollup.cache/
.swc/
.turbo/
.vercel/
.netlify/

# System & OS Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# IDEs, Editors & Workspaces
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Agent & Generator Temporary Files
.gemini/
.agents/
remove_comments.js
strip_comments.js
strip_all_comments.js
generate_docs.js
generate_massive_docs.js
generate_massive.js
fix_docs.js
frontend/run_build.js
frontend/build_output.txt

# Local Automation & Upgrade Scripts
upgrade_all.bat
upgrade_all.sh
deploy-anchor.js
solana-install.sh
seed_superadmin.js
**/seed_superadmin.js
